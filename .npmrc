# The lockfile is the pinned build input (see DECISIONS.md D-0003): CI installs
# with `npm ci`, which refuses to proceed when package.json and the lockfile
# disagree. save-exact keeps the manifest honest about what was resolved.
save-exact=true
# better-sqlite3 is a native addon. Never let a missing prebuilt binary pass
# silently as "installed but unusable" -- the native-load smoke test is the
# second half of this guarantee.
fund=false
audit=false
